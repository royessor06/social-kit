generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PosterTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String
  htmlContent String   @db.Text
  thumbnail   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creations   PosterCreation[]

  @@index([category])
  @@index([active])
}

model PosterCreation {
  id          String   @id @default(cuid())
  templateId  String
  data        Json
  paid        Boolean  @default(false)
  exportedAt  DateTime?
  createdAt   DateTime @default(now())

  template    PosterTemplate @relation(fields: [templateId], references: [id])

  @@index([templateId])
  @@index([paid])
}

model ClientSite {
  id           String   @id @default(cuid())
  slug         String   @unique
  businessName String
  templateId   String
  data         Json
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published])
}